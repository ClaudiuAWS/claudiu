# Copy this file to `.env` (still gitignored) and fill in the values from
# the deployed AWS stack. Ask a teammate for the current values — they
# point at the prod Cognito user pool + API Gateway, so they're not
# really secret but pasting them here keeps the repo clean.

# Cognito user pool — create accounts and sign in. From the
# `cognito-claudiu-auth` CFN stack outputs.
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=

# REST API base URL (used for /rooms, /matches, /react, etc.). From the
# `api-gateway-claudiu` stack — the invoke URL with `/prod` stage.
VITE_API_URL=

# WebSocket API endpoint — used for live match feed, score updates, chat,
# AI Director commentary, mini-game broadcasts. From the
# `claudiu-ws-api` stack output (`claudiu-ws-url`).
VITE_WS_URL=
